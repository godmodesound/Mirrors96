{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "godmodesound",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "backgroundColor": "#000000",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Transmit voice instantly via Direct Connect",
        "NSCameraUsageDescription": "Record video chirps to share with contacts",
        "NSPhotoLibraryUsageDescription": "Upload a photo to customize your CODES I.D.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bundleIdentifier": "app.emergent.binauralpreview2d067bc8",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "VIBRATE",
        "CAMERA"
      ],
      "package": "com.emergent.binauralpreview.lfhc0u"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
